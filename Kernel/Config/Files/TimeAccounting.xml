<?xml version="1.0" encoding="utf-8" ?>
<kix_config version="1.0" init="Framework">
    <ConfigItem AccessLevel="internal" Name="TimeAccounting::EventModulePost###900-TicketAccountedTimeUpdate" Required="0" Valid="1">
        <Description Translatable="1">Updates the “Accounted Time” on the ticket.</Description>
        <Group>Ticket</Group>
        <SubGroup>Core::Ticket</SubGroup>
        <Setting>
            <Hash>
                <Item Key="Module">Kernel::System::Ticket::Event::TicketAccountedTimeUpdate</Item>
                <Item Key="Event">TimeAccounting(?:Create|Update|Delete)</Item>
                <Item Key="Transaction">1</Item>
            </Hash>
        </Setting>
    </ConfigItem>
    <ConfigItem AccessLevel="internal" Name="Events###TimeAccounting" Required="1" Valid="1">
        <Description Translatable="1">List of all time accounting events to be displayed in the GUI.</Description>
        <Group>TimeAccounting</Group>
        <SubGroup>Frontend::Admin</SubGroup>
        <Setting>
            <Array>
                <Item>TimeAccountingCreate</Item>
                <Item>TimeAccountingDelete</Item>
                <Item>TimeAccountingUpdate</Item>
            </Array>
        </Setting>
    </ConfigItem>
</kix_config>